---
import '~/styles/global.css';
import type { Lang } from '~/lib/i18n';
import { site } from '~/lib/projects';

interface Props {
  lang: Lang;
  title?: string;
}

const { lang, title } = Astro.props;
const fullTitle = title ? `${title} — ${site.artist}` : site.artist;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="preload" href="/fonts/AxellHostyn.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/SilvanaText-Regular.otf" as="font" type="font/otf" crossorigin />
    <script>
      // Cursor uses the AxellHostyn glyph. Fonts are same-origin via local
      // @font-face so document.fonts.load() resolves quickly once the
      // browser has fetched the file.
      const CURSOR_CHAR = 'q';
      const CURSOR_FONT = 'AxellHostyn';
      const CURSOR_SIZE = 32;

      function applyCursor() {
        const dpr = window.devicePixelRatio || 1;
        const c = document.createElement('canvas');
        c.width = CURSOR_SIZE * dpr;
        c.height = CURSOR_SIZE * dpr;
        const ctx = c.getContext('2d');
        if (!ctx) return;
        ctx.scale(dpr, dpr);
        ctx.font = `${CURSOR_SIZE - 4}px "${CURSOR_FONT}", sans-serif`;
        ctx.textBaseline = 'middle';
        ctx.textAlign = 'center';
        ctx.fillStyle = '#000';
        ctx.fillText(CURSOR_CHAR, CURSOR_SIZE / 2, CURSOR_SIZE / 2);
        const url = c.toDataURL('image/png');
        const half = Math.round(CURSOR_SIZE / 2);
        const value = `url('${url}') ${half} ${half}, auto`;
        const styleId = 'custom-cursor-style';
        let style = document.getElementById(styleId);
        if (!style) {
          style = document.createElement('style');
          style.id = styleId;
          document.head.appendChild(style);
        }
        style.textContent = `*, *::before, *::after { cursor: ${value} !important; }`;
      }

      if ('fonts' in document) {
        document.fonts.load(`${CURSOR_SIZE - 4}px "${CURSOR_FONT}"`).then(applyCursor).catch(applyCursor);
      } else {
        window.addEventListener('load', applyCursor);
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
