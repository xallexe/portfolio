---
import '~/styles/global.css';
import type { Lang } from '~/lib/i18n';
import { site } from '~/lib/projects';

interface Props {
  lang: Lang;
  title?: string;
}

const { lang, title } = Astro.props;
const fullTitle = title ? `${title} — ${site.artist}` : site.artist;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <!-- Yellow cheese block: the 'q' glyph of blockhead-illust-ot, outlined to SVG. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/MariaMagdalena-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/SilvanaText-Regular.otf" as="font" type="font/otf" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
