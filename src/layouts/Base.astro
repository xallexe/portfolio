---
import '~/styles/global.css';
import type { Lang } from '~/lib/i18n';
import { site } from '~/lib/projects';

interface Props {
  lang: Lang;
  title?: string;
}

const { lang, title } = Astro.props;
const fullTitle = title ? `${title} — ${site.artist}` : site.artist;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/qyw6yte.css" />
    <script>
      // Cursor runs in <head> right after the Typekit stylesheet so the
      // font download is kicked off as early as possible. The stylesheet
      // link blocks this script until parsed, which is exactly what we want
      // (the @font-face must be registered before fonts.load() works).
      const CURSOR_CHAR = 'q';
      const CURSOR_FONT = 'blockhead-illust-ot';
      const CURSOR_SIZE = 32;

      function applyCursor() {
        const dpr = window.devicePixelRatio || 1;
        const c = document.createElement('canvas');
        c.width = CURSOR_SIZE * dpr;
        c.height = CURSOR_SIZE * dpr;
        const ctx = c.getContext('2d');
        if (!ctx) return;
        ctx.scale(dpr, dpr);
        ctx.font = `${CURSOR_SIZE - 4}px "${CURSOR_FONT}", sans-serif`;
        ctx.textBaseline = 'middle';
        ctx.textAlign = 'center';
        ctx.fillStyle = '#000';
        ctx.fillText(CURSOR_CHAR, CURSOR_SIZE / 2, CURSOR_SIZE / 2);
        const url = c.toDataURL('image/png');
        const half = Math.round(CURSOR_SIZE / 2);
        const value = `url('${url}') ${half} ${half}, auto`;
        const styleId = 'custom-cursor-style';
        let style = document.getElementById(styleId);
        if (!style) {
          style = document.createElement('style');
          style.id = styleId;
          document.head.appendChild(style);
        }
        style.textContent = `*, *::before, *::after { cursor: ${value} !important; }`;
      }

      if ('fonts' in document) {
        document.fonts.load(`${CURSOR_SIZE - 4}px "${CURSOR_FONT}"`).then(applyCursor).catch(applyCursor);
      } else {
        window.addEventListener('load', applyCursor);
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
