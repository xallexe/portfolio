---
import '~/styles/global.css';
import type { Lang } from '~/lib/i18n';
import { site } from '~/lib/projects';

interface Props {
  lang: Lang;
  title?: string;
}

const { lang, title } = Astro.props;
const fullTitle = title ? `${title} — ${site.artist}` : site.artist;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="preload" href="/fonts/AxellHostyn.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/SilvanaText-Regular.otf" as="font" type="font/otf" crossorigin />
    <!-- Typekit kit qyw6yte — Axelle's Adobe Fonts account — serves
         blockhead-illust-ot, the custom illustration font whose 'q' glyph is
         the cheese-block cursor. Loaded inline in the head so the cursor
         script below can resolve the font via document.fonts. -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/qyw6yte.css" />
    <script>
      const CURSOR_CHAR = 'q';
      const CURSOR_FONT = 'blockhead-illust-ot';
      const CURSOR_SIZE = 32;
      const CURSOR_PX = CURSOR_SIZE - 4;

      function applyCursor() {
        const dpr = window.devicePixelRatio || 1;
        const c = document.createElement('canvas');
        c.width = CURSOR_SIZE * dpr;
        c.height = CURSOR_SIZE * dpr;
        const ctx = c.getContext('2d');
        if (!ctx) return;
        ctx.scale(dpr, dpr);
        ctx.font = `${CURSOR_PX}px "${CURSOR_FONT}", sans-serif`;
        // Touching measureText forces the canvas to resolve its font stack
        // against the FontFaceSet *now*, before fillText snapshots a glyph.
        ctx.measureText(CURSOR_CHAR);
        ctx.textBaseline = 'middle';
        ctx.textAlign = 'center';
        ctx.fillStyle = '#000';
        ctx.fillText(CURSOR_CHAR, CURSOR_SIZE / 2, CURSOR_SIZE / 2);
        const url = c.toDataURL('image/png');
        const half = Math.round(CURSOR_SIZE / 2);
        const value = `url('${url}') ${half} ${half}, auto`;
        const styleId = 'custom-cursor-style';
        let style = document.getElementById(styleId);
        if (!style) {
          style = document.createElement('style');
          style.id = styleId;
          document.head.appendChild(style);
        }
        style.textContent = `*, *::before, *::after { cursor: ${value} !important; }`;
      }

      if ('fonts' in document) {
        // ready waits until every CSS-declared font has finished loading or
        // erroring, so Typekit's @import chain is fully resolved before we
        // try to use blockhead-illust-ot in the canvas.
        document.fonts.ready
          .then(() => document.fonts.load(`${CURSOR_PX}px "${CURSOR_FONT}"`))
          .then(() => requestAnimationFrame(applyCursor))
          .catch(applyCursor);
      } else {
        window.addEventListener('load', applyCursor);
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
