---
import Base from '~/layouts/Base.astro';
import LeftNav from '~/components/LeftNav.astro';
import PhotoCard from '~/components/PhotoCard.astro';
import Lightbox from '~/components/Lightbox.astro';
import { projects } from '~/lib/projects';
import { pathFor } from '~/lib/i18n';

const lang = 'nl' as const;

// Flatten every photo across every project. The home page no longer
// groups photos by project; client-side JS shuffles them on load and
// each click deep-links via #p<idx> to the photo on its project page.
const allPhotos = projects.flatMap((p) =>
  p.photos.map((entry, idx) => ({
    entry,
    href: pathFor(lang, `/work/${p.id}#p${idx}`),
  }))
);

const half = Math.ceil(allPhotos.length / 2);
const photosA = allPhotos.slice(0, half);
const photosB = allPhotos.slice(half);
---

<Base lang={lang}>
  <div class="layout">
    <LeftNav lang={lang} current="home" />

    <main class="photos">
      <div class="col" id="col-a">
        {photosA.map((p) => <PhotoCard entry={p.entry} lang={lang} linkTo={p.href} />)}
      </div>

      <div class="col" id="col-b">
        {photosB.map((p) => <PhotoCard entry={p.entry} lang={lang} linkTo={p.href} />)}
      </div>
    </main>
  </div>

  <Lightbox lang={lang} />
</Base>

<script>
  const colA = document.getElementById('col-a');
  const colB = document.getElementById('col-b');

  // SessionStorage key — survives detail→back navigation but resets on tab close.
  const STORAGE_KEY = 'home-scroll-nl';

  function shuffle(col: HTMLElement) {
    const items = Array.from(col.children) as HTMLElement[];
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }
    // appendChild on an already-attached node moves it — re-attach in new order.
    items.forEach((item) => col.appendChild(item));
  }

  function shuffleAll() {
    if (!colA || !colB) return;
    shuffle(colA);
    shuffle(colB);
  }

  function scrollToRandomPhoto(col: HTMLElement) {
    const photos = col.querySelectorAll<HTMLElement>('.photo');
    if (photos.length === 0) return;
    const pick = photos[Math.floor(Math.random() * photos.length)];
    col.scrollTo({ top: pick.offsetTop });
  }

  function randomOverview() {
    if (!colA || !colB) return;
    scrollToRandomPhoto(colA);
    scrollToRandomPhoto(colB);
  }

  function saveScrollState() {
    if (!colA || !colB) return;
    sessionStorage.setItem(STORAGE_KEY, JSON.stringify({ a: colA.scrollTop, b: colB.scrollTop }));
  }

  function restoreScrollState(): boolean {
    if (!colA || !colB) return false;
    const raw = sessionStorage.getItem(STORAGE_KEY);
    if (!raw) return false;
    try {
      const { a, b } = JSON.parse(raw) as { a: number; b: number };
      colA.scrollTo({ top: a });
      colB.scrollTo({ top: b });
      return true;
    } catch {
      return false;
    }
  }

  // Save scroll state right before navigating into a project detail.
  document.querySelectorAll<HTMLAnchorElement>('.col .thumb').forEach((link) => {
    link.addEventListener('click', () => saveScrollState());
  });

  // Clicking Home while already on home explicitly means "shuffle" — drop saved state.
  document.querySelectorAll<HTMLAnchorElement>('.leftnav nav a[href="/"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', '/');
      sessionStorage.removeItem(STORAGE_KEY);
      shuffleAll();
      randomOverview();
    });
  });

  window.addEventListener('load', () => {
    // Restore-scroll wins: same photos in same DOM order so the saved
    // scrollTop lands on the same image. Otherwise: fresh shuffle.
    if (restoreScrollState()) return;
    shuffleAll();
    randomOverview();
  });
</script>
