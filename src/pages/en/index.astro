---
import Base from '~/layouts/Base.astro';
import LeftNav from '~/components/LeftNav.astro';
import PhotoCard from '~/components/PhotoCard.astro';
import Lightbox from '~/components/Lightbox.astro';
import { projects, columnFor } from '~/lib/projects';
import { pathFor } from '~/lib/i18n';

const lang = 'en' as const;

const sorted = [...projects].sort((a, b) => a.order - b.order);
const flatten = (col: 'a' | 'b') =>
  sorted
    .filter((p) => columnFor(p) === col)
    .flatMap((p) =>
      p.photos.map((entry, idx) => ({
        entry,
        href: pathFor(lang, `/work/${p.id}#p${idx}`),
      }))
    );
const photosA = flatten('a');
const photosB = flatten('b');
---

<Base lang={lang}>
  <div class="layout">
    <LeftNav lang={lang} current="home" />

    <main class="photos">
      <div class="col" id="col-a">
        {photosA.map((p) => <PhotoCard entry={p.entry} lang={lang} linkTo={p.href} />)}
      </div>

      <div class="col" id="col-b">
        {photosB.map((p) => <PhotoCard entry={p.entry} lang={lang} linkTo={p.href} />)}
      </div>
    </main>
  </div>

  <Lightbox lang={lang} />
</Base>

<script>
  const colA = document.getElementById('col-a');
  const colB = document.getElementById('col-b');

  function scrollToRandomPhoto(col: HTMLElement) {
    const photos = col.querySelectorAll<HTMLElement>('.photo');
    if (photos.length === 0) return;
    const pick = photos[Math.floor(Math.random() * photos.length)];
    col.scrollTo({ top: pick.offsetTop });
  }

  function randomOverview() {
    if (!colA || !colB) return;
    scrollToRandomPhoto(colA);
    scrollToRandomPhoto(colB);
  }

  document.querySelectorAll<HTMLAnchorElement>('.leftnav nav a[href="/en/"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', '/en/');
      randomOverview();
    });
  });

  window.addEventListener('load', () => {
    randomOverview();
  });
</script>
