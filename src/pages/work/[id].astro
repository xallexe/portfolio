---
import { marked } from 'marked';
import Base from '~/layouts/Base.astro';
import LeftNav from '~/components/LeftNav.astro';
import PhotoCard from '~/components/PhotoCard.astro';
import Lightbox from '~/components/Lightbox.astro';
import { localized } from '~/lib/i18n';
import { type Project } from '~/lib/projects';

export async function getStaticPaths() {
  const { projects } = await import('~/lib/projects');
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}

interface Props { project: Project }

const { project } = Astro.props;
const lang = 'nl' as const;

const name = localized(lang, project.name, project.name_en);
const title = localized(lang, project.title, project.title_en);
const medium = localized(lang, project.medium, project.medium_en);
const klant = project.klant?.trim() ?? '';
const info = localized(lang, project.info, project.info_en);
const infoHtml = info ? marked.parse(info, { async: false }) as string : '';
---

<Base lang={lang} title={name}>
  <div class="layout layout--detail">
    <LeftNav lang={lang} current={project.id} />

    <div class="carousel">
      <main class="photos-h" id="photos-h">
        {project.photos.map((entry, idx) => (
          <PhotoCard entry={entry} lang={lang} variant="horizontal" id={`p${idx}`} />
        ))}
      </main>
      {project.photos.length > 1 && (
        <div class="photo-dots" aria-label="foto navigatie">
          {project.photos.map((_, idx) => (
            <button type="button" data-photo-dot aria-label={`foto ${idx + 1}`} />
          ))}
        </div>
      )}
    </div>

    <aside class="details">
      <h1>{name}</h1>
      <dl class="meta">
        {title && <><dt>titel</dt><dd>{title}</dd></>}
        {medium && <><dt>medium</dt><dd>{medium}</dd></>}
        {klant && <><dt>klant</dt><dd>{klant}</dd></>}
      </dl>
      {infoHtml && <div class="info" set:html={infoHtml} />}
    </aside>
  </div>

  <Lightbox lang={lang} />
</Base>

<script>
  const strip = document.getElementById('photos-h');
  if (strip) {
    // Map vertical wheel scrolling to horizontal scroll on the photo strip,
    // so you can browse with a normal mousewheel without holding Shift.
    strip.addEventListener(
      'wheel',
      (e) => {
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          e.preventDefault();
          // deltaMode 0 = pixels (trackpad / smooth wheel) — modest multiplier.
          // deltaMode 1 = lines (classic mouse wheel) — much larger jump per notch.
          const mult = e.deltaMode === 0 ? 3 : 60;
          // 'instant', not 'auto': .photos-h has scroll-behavior: smooth, so 'auto'
          // restarted a smooth animation on every wheel tick and felt sluggish.
          strip.scrollBy({ left: e.deltaY * mult, behavior: 'instant' });
        }
      },
      { passive: false }
    );

    // Deep-link from home: /work/<id>#p<idx> scrolls that photo into view.
    function scrollToHash() {
      const hash = window.location.hash.replace('#', '');
      if (!hash) return;
      const target = strip!.querySelector<HTMLElement>(`#${CSS.escape(hash)}`);
      if (target) {
        strip!.scrollTo({ left: target.offsetLeft, behavior: 'auto' });
      }
    }
    if (document.readyState === 'complete') scrollToHash();
    else window.addEventListener('load', scrollToHash);

    // Dots under the strip: one per photo, the active one follows the
    // scroll position, clicking one jumps to that photo.
    const photos = Array.from(strip.querySelectorAll<HTMLElement>('.photo-h'));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-photo-dot]'));

    function currentIndex(): number {
      const sl = strip!.scrollLeft;
      // The last photo can't scroll all the way to the left edge, so treat
      // "scrolled to the end" as being on the last photo.
      if (sl > 0 && sl >= strip!.scrollWidth - strip!.clientWidth - 2) return photos.length - 1;
      let best = 0;
      let bestDist = Infinity;
      for (let i = 0; i < photos.length; i++) {
        const d = Math.abs(photos[i].offsetLeft - sl);
        if (d < bestDist) { bestDist = d; best = i; }
      }
      return best;
    }

    function updateDots() {
      const idx = currentIndex();
      dots.forEach((d, i) => d.setAttribute('aria-current', i === idx ? 'true' : 'false'));
    }

    dots.forEach((d, i) => d.addEventListener('click', () => {
      strip!.scrollTo({ left: photos[i].offsetLeft, behavior: 'smooth' });
    }));

    let scrollTick = 0;
    strip.addEventListener('scroll', () => {
      cancelAnimationFrame(scrollTick);
      scrollTick = requestAnimationFrame(updateDots);
    }, { passive: true });
    updateDots();
    // Lazy images change the photo widths once they arrive.
    window.addEventListener('load', updateDots);
  }
</script>
