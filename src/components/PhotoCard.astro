---
import type { Lang } from '~/lib/i18n';
import { localized } from '~/lib/i18n';
import type { PhotoEntry } from '~/lib/projects';

interface Props {
  entry: PhotoEntry;
  lang: Lang;
  /** 'vertical' (home: stacked column) or 'horizontal' (detail: side-by-side row). */
  variant?: 'vertical' | 'horizontal';
  /** If set, photo is a link to this URL instead of a lightbox-trigger. */
  linkTo?: string;
  /** Optional DOM id (used for hash-based deep-linking on detail pages). */
  id?: string;
}

const { entry, lang, variant = 'vertical', linkTo, id } = Astro.props;
const caption = localized(lang, entry.info, entry.info_en);
const wrapClass = variant === 'horizontal' ? 'photo-h' : 'photo';
const src = entry.file;
const alt = caption || src.split('/').pop() || '';

// Point at the webp variants generated by scripts/optimize-images.mjs.
// "/uploads/photos/foo.JPG" → "/uploads/photos/_opt/foo-{w}.webp".
const VARIANT_WIDTHS = [800, 1600, 2400];
function makeWebpSrcset(p: string): string | null {
  const m = p.match(/^(.*)\/([^/]+)\.[^.]+$/);
  if (!m) return null;
  const [, dir, base] = m;
  const optDir = `${dir}/_opt`;
  return VARIANT_WIDTHS.map((w) => `${optDir}/${base}-${w}.webp ${w}w`).join(', ');
}
const webpSrcset = makeWebpSrcset(src);
const sizes = variant === 'horizontal' ? '95vw' : '(max-width: 720px) 100vw, 45vw';
---

<figure class={wrapClass} id={id}>
  {linkTo ? (
    <a class="thumb" href={linkTo} aria-label={alt}>
      <picture>
        {webpSrcset && <source type="image/webp" srcset={webpSrcset} sizes={sizes} />}
        <img src={src} alt={alt} loading="lazy" decoding="async" />
      </picture>
    </a>
  ) : (
    <button
      type="button"
      class="thumb"
      data-lightbox-src={src}
      data-lightbox-caption={caption}
      aria-label={alt}
    >
      <picture>
        {webpSrcset && <source type="image/webp" srcset={webpSrcset} sizes={sizes} />}
        <img src={src} alt={alt} loading="lazy" decoding="async" />
      </picture>
    </button>
  )}
  {caption && variant === 'vertical' && <figcaption class="caption">{caption}</figcaption>}
</figure>
