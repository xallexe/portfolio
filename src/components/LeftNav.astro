---
import type { Lang } from '~/lib/i18n';
import { ui, pathFor, localized } from '~/lib/i18n';
import { projects, site } from '~/lib/projects';

interface Props {
  lang: Lang;
  current?: 'home' | 'contact' | string;
}

const { lang, current } = Astro.props;
const homePath = pathFor(lang, '/');
const contactPath = pathFor(lang, '/contact');

const currentPath = Astro.url.pathname;
const stripped = currentPath.replace(/^\/en\/?/, '/');
const nlPath = stripped === '' ? '/' : stripped;
const enPath = stripped === '/' ? '/en/' : `/en${stripped}`;
---

<aside class="leftnav">
  <a class={`artist ${current === 'home' ? 'active' : ''}`} href={homePath}>{site.artist}</a>

  <nav>
    <div class="section-label">{ui[lang].work}</div>
    {[...projects].sort((a, b) => a.order - b.order).map((p) => (
      <a
        href={pathFor(lang, `/work/${p.id}`)}
        class={current === p.id ? 'active' : ''}
        data-project={p.id}
      >
        {localized(lang, p.name, p.name_en)}
      </a>
    ))}
  </nav>

  <div class="bottom-block">
    <a class={`contact-link ${current === 'contact' ? 'active' : ''}`} href={contactPath}>{ui[lang].contact}</a>
    <div class="lang-switch">
      <a href={nlPath} class={lang === 'nl' ? 'active' : ''}>nl</a>
      <span>/</span>
      <a href={enPath} class={lang === 'en' ? 'active' : ''}>en</a>
    </div>
  </div>
</aside>
